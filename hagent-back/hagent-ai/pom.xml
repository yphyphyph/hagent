<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hagent</groupId>
        <artifactId>hagent-back</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>hagent-ai</artifactId>
    <name>hagent-ai</name>
    <description>AI 模块 - Spring AI 集成、智能对话、RAG</description>

    <dependencies>
        <!-- Internal: hagent-common -->
        <dependency>
            <groupId>com.hagent</groupId>
            <artifactId>hagent-common</artifactId>
        </dependency>

        <!-- 知识库模块：用于来源兜底时通过 KnowledgeFileMapper 查询 file_name -->
        <dependency>
            <groupId>com.hagent</groupId>
            <artifactId>hagent-module-knowledge</artifactId>
        </dependency>

        <!-- Spring AI OpenAI -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- OpenAI Java SDK OkHttp Client (required for AiModelProvider) -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java-client-okhttp</artifactId>
            <version>4.39.1</version>
        </dependency>

        <!-- Spring AI PgVector VectorStore（PostgreSQL + pgvector）-->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!-- WebFlux (SSE streaming) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Reactor Test (for StepVerifier in tests) -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring AI Agent Utils (AutoMemoryToolsAdvisor) -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-agent-utils</artifactId>
            <version>0.10.0</version>
        </dependency>

        <!-- JSON Schema Module for Jackson (must match Spring AI 2.0.0 GA's dependency) -->
        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-module-jackson</artifactId>
            <version>5.0.0</version>
        </dependency>

        <!-- Spring AI MCP Server (WebMVC SSE transport) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
    </dependencies>
</project>
