# HAgent 后端本地环境变量示例
# 用法：复制本文件为 .env（或直接设置系统环境变量），填入真实值后生效。
# 注意：.env 与 application-local.yml 均已被 .gitignore 排除，禁止提交真实值。

# MySQL 数据库密码（对应 application-dev.yml: spring.datasource.password）
HAGENT_MYSQL_PASSWORD=

# Redis 密码（对应 application-dev.yml: spring.data.redis.password）
HAGENT_REDIS_PASSWORD=

# 阿里云 OSS AccessKeyId（对应 application-dev.yml: aliyun.oss.access-key-id）
HAGENT_OSS_ACCESS_KEY_ID=

# 阿里云 OSS AccessKeySecret（对应 application-dev.yml: aliyun.oss.access-key-secret）
HAGENT_OSS_ACCESS_KEY_SECRET=
