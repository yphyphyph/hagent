# ============================================================
# HAgent 环境变量清单（示例文件）
# 使用方式（二选一）：
#   1. 本地裸跑后端：写入 hagent-server/src/main/resources/application-local.yml（该文件不入 Git）
#   2. Docker 部署：复制本文件为仓库根目录 .env，start_hagent.sh / docker compose 会自动读取
# 敏感值严禁直接写入 application.yml 等入库文件
# ============================================================

# ---- PostgreSQL + pgvector（必填，库 hagent 需已执行 database/schema-postgres.sql）----
HAGENT_DB_HOST=127.0.0.1
HAGENT_DB_PASSWORD=你的PG密码
# 可选覆盖完整连接串（默认由 HAGENT_DB_HOST 拼装）
# DB_URL=jdbc:postgresql://${HAGENT_DB_HOST}:5432/hagent?stringtype=unspecified
# DB_USERNAME=postgres

# ---- Redis（必填）----
HAGENT_REDIS_HOST=127.0.0.1
HAGENT_REDIS_PORT=6379
HAGENT_REDIS_PASSWORD=你的Redis密码

# ---- 阿里云 OSS（知识库文件上传，必填）----
HAGENT_OSS_ACCESS_KEY_ID=你的AccessKeyID
HAGENT_OSS_ACCESS_KEY_SECRET=你的AccessKeySecret

# ---- AI 模型（可选：AI 参数可在管理后台"AI设置"页配置并存库，热更新）----
# 仅当需要在启动期兜底时设置
OPENAI_API_KEY=你的模型APIKey
OPENAI_BASE_URL=https://api.example.com/v1

# ---- JWT（说明）----
# JWT 为遗留代码，主鉴权走 Sa-Token；application.yml 中的默认值仅满足启动校验。
# 生产环境建议显式设置 JWT_SECRET_KEY 覆盖默认值。
# JWT_SECRET_KEY=生产环境随机长随机串
